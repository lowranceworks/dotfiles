#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# One installer for custom and upstream skills. Re-run after manifest changes
# or a new committed source HEAD; uncommitted skill edits are not installable.
# skills.toml: {{ includeTemplate "dot_config/skills/skills.toml.tmpl" . | sha256sum }}
# local-source: {{ .chezmoi.sourceDir }}
# local-commit: {{ output "git" "-C" .chezmoi.sourceDir "rev-parse" "HEAD" | trim }}

if [ -n "${CI:-}" ]; then
    echo "Skipping due to \$CI"
    exit
fi

# Pinned so a `skills` release doesn't silently change apply behavior on one
# machine before another. Bump deliberately. Only installs when missing —
# upgrades are manual (`skills` self-update or rerun of install.sh).
skills_version="v0.2.1"

if ! command -v skills &>/dev/null; then
    if ! command -v curl &>/dev/null; then
        echo "Skipping: neither skills nor curl found"
        exit 0
    fi
    echo "Installing skills ${skills_version}"
    VERSION="$skills_version" BINDIR="$HOME/.local/bin" \
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/owainlewis/skills/main/install.sh)"
    export PATH="$HOME/.local/bin:$PATH"
fi

# --config is explicit so this works in chezmoi's non-interactive shell.
# No automatic pruning: v0.2.1 can remove installed skills after source failure.
# Inspect a successful full sync and back up the pools before manual --prune.
skills sync --config "$HOME/.config/skills/skills.toml"
