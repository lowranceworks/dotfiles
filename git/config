[init]
	defaultBranch = main

[user]
	name = Joshua Lowrance
	email = joshua.lowrance@mlb.com

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	features = catppuccin-mocha

[diff]
	algorithm = histogram
	colorMoved = zebra

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[include]
	path = ~/.config/git/catppuccin.gitconfig

[includeIf "gitdir:~/projects/lowranceworks/"]
	path = ~/.config/git/personal

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://github.mlbam.net"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
