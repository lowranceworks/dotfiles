# Cy settings. Secrets (tokens, phone numbers) do NOT belong here —
# they live in config.local.env (gitignored). Env vars override these values.

# LLM provider: copilot (GitHub Copilot Enterprise) or local (llama.cpp)
provider: copilot

# Model slots: chat = conversation; task = GitHub repo work + brainstorming
models:
  chat: claude-haiku-4.5
  task: claude-fable-5.1

# Slack channels Cy may access. access: read | readwrite | ignore
# Placeholders only — real channel names/IDs live per-machine in
# ~/.config/cy/slack.local.md (untracked; this repo is public).
slack:
  channels:
    - name: team-private
      id: CXXXXXXXXXX
      access: read
    - name: team-engage
      id: CYYYYYYYYYY
      access: readwrite

# Work controller: watches item notes under vault.root (vault + repos are
# private — see below) and reminds hourly during work hours.
controller:
  watch: [20-Projects/Submitted, 20-Projects/Todo, 20-Projects/In-Progress, 20-Projects/Blocked]
  work_hours: { days: mon-fri, start: "08:00", end: "17:00" }
  remind_every: 1h

# Jira is the source of truth for status; Cy mirrors each item note into
# the folder for its status every 10 minutes.
jira:
  work_backlog: false
  status_folders:
    Submitted: 20-Projects/Submitted
    Backlog: 20-Projects/Todo
    To Do: 20-Projects/Todo
    Current Sprint: 20-Projects/Todo
    In Progress: 20-Projects/In-Progress
    Needs More Info: 20-Projects/Blocked
    Parked: 20-Projects/Blocked
    Cancelled: 20-Projects/Canceled
    Done: 20-Projects/Completed

# Private sections (vault:, repos:) come from the local, untracked
# ~/.config/chezmoi/cy.private.yaml — see docs/cy-private.example.yaml.
{{- $private := joinPath .chezmoi.homeDir ".config/chezmoi/cy.private.yaml" }}
{{- if stat $private }}
# --- private (from ~/.config/chezmoi/cy.private.yaml) ---
{{ include $private }}
{{- end }}
