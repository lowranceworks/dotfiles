abbr tgaaa "terragrunt run-all apply --auto-approve"
abbr tgad "terragrunt run-all destroy"
abbr tgada "terragrunt run-all destroy --auto-approve"
abbr tgaf "terragrunt run-all fmt"
abbr tgai "terragrunt run-all init"
