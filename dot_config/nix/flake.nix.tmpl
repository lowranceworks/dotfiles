{
  description = "nix-darwin system flake: macOS settings";

  # chezmoi template, rendered per machine into ~/.config/nix/flake.nix.
  # Apply with:
  #   sudo darwin-rebuild switch --flake ~/.config/nix
  # darwin-rebuild picks the configuration named after `scutil --get LocalHostName`,
  # which chezmoi fills in below, so any Mac gets a matching configuration.
  #
  # Packages are not managed here: Homebrew installs them from
  # ~/.config/homebrew/Brewfile (see .chezmoiscripts/run_once_after_10-homebrew.sh).

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    nix-darwin.url = "github:nix-darwin/nix-darwin/master";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs =
    inputs@{
      self,
      nix-darwin,
      nixpkgs,
    }:
    let
      user = "{{ .chezmoi.username }}";
      host = "{{ output "scutil" "--get" "LocalHostName" | trim }}";

      configuration =
        { lib, pkgs, ... }:
        {
          nixpkgs.hostPlatform = "aarch64-darwin";

          ids.gids.nixbld = 350; # GID the Nix installer gives nixbld on macOS
          # Per machine: the value at this Mac's first nix-darwin install; never bump.
          # Set by the nixStateVersion prompt in .chezmoi.toml.tmpl.
          system.stateVersion = {{ get . "nixStateVersion" | default 7 }};
          system.configurationRevision = self.rev or self.dirtyRev or null;
          system.primaryUser = user;

          nix.settings.experimental-features = "nix-command flakes";

          programs.zsh.enable = true;
          programs.fish.enable = true;
          # Enabling Fish configures it, but doesn't register it as a login shell.
          environment.shells = [ pkgs.fish ];

          security.pam.services.sudo_local.touchIdAuth = true;

          # Caps Lock -> Control on the built-in keyboard only; external keyboards
          # (the Logitech) keep Caps Lock. nix-darwin's system.keyboard remap
          # applies to every keyboard, so a launchd daemon runs hidutil with a
          # Built-In match instead, at boot and on every switch.
          system.keyboard.enableKeyMapping = false;
          launchd.daemons.remap-builtin-capslock.serviceConfig = {
            ProgramArguments = [
              "/usr/bin/hidutil"
              "property"
              "--matching"
              ''{"Built-In":true}''
              "--set"
              ''{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":30064771129,"HIDKeyboardModifierMappingDst":30064771300}]}''
            ];
            RunAtLoad = true;
          };

          system.activationScripts.postActivation.text = ''
            # Change only the login shell; macOS still owns the existing account.
            # Do not add the primary account to users.knownUsers.
            currentShell=$(/usr/bin/dscl . -read ${lib.escapeShellArg "/Users/${user}"} UserShell)
            if [ "$currentShell" != "UserShell: /run/current-system/sw/bin/fish" ]; then
              /usr/bin/chsh -s /run/current-system/sw/bin/fish ${lib.escapeShellArg user}
            fi

            # Screenshots save here (below); macOS won't create the directory.
            sudo --user=${user} -- mkdir -p /Users/${user}/Pictures/screenshots

            # Disable Cmd-Shift-3/4/5/6 and screenshot clipboard variants.
            # Merge only screenshot entries; CustomUserPreferences would replace
            # AppleSymbolicHotKeys and reset unrelated shortcuts (e.g. Spotlight).
            for hotkey in 28 29 30 31 181 182 184; do
              launchctl asuser "$(id -u -- ${lib.escapeShellArg user})" \
                sudo --user=${lib.escapeShellArg user} -- \
                defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys \
                -dict-add "$hotkey" ${lib.escapeShellArg (lib.generators.toPlist { escape = true; } { enabled = false; })}
            done
          '';

          system.defaults = {
            NSGlobalDomain = {
              AppleInterfaceStyle = "Dark";
              AppleShowAllExtensions = true;
              InitialKeyRepeat = 17;
              KeyRepeat = 2;
              NSAutomaticWindowAnimationsEnabled = true;
              NSScrollAnimationEnabled = true;
              NSWindowResizeTime = 0.2;
              _HIHideMenuBar = true; # menu bar auto-hides; SketchyBar replaces it
              "com.apple.trackpad.scaling" = 1.0;
            };

            ".GlobalPreferences"."com.apple.mouse.scaling" = 3.0;

            dock = {
              autohide = true;
              orientation = "right";
              mineffect = "scale";
              mru-spaces = false;
              wvous-br-corner = 14; # Quick Note
              persistent-apps = [
                "/System/Applications/Apps.app"
                "/System/Applications/Calendar.app"
                "/Applications/Ghostty.app"
                "/Applications/Dia.app"
                "/Applications/Bitwarden.app"
                "/Applications/draw.io.app"
              ];
              persistent-others = [
                {
                  folder = {
                    path = "/Users/${user}/Downloads";
                    arrangement = "date-added";
                    displayas = "stack";
                    showas = "fan";
                  };
                }
              ];
            };

            finder = {
              AppleShowAllExtensions = true;
              AppleShowAllFiles = true;
              FXDefaultSearchScope = "SCcf"; # search the current folder
              FXPreferredViewStyle = "Nlsv"; # list view
              ShowPathbar = true;
              ShowStatusBar = false;
              ShowExternalHardDrivesOnDesktop = true;
              ShowHardDrivesOnDesktop = false;
              ShowRemovableMediaOnDesktop = true;
            };

            trackpad = {
              Clicking = false; # no tap to click
              Dragging = false;
              DragLock = false;
              TrackpadRightClick = true;
              TrackpadCornerSecondaryClick = 0;
              TrackpadThreeFingerDrag = false;
              TrackpadThreeFingerTapGesture = 0;
              TrackpadTwoFingerFromRightEdgeSwipeGesture = 3; # Notification Center
              FirstClickThreshold = 1;
              SecondClickThreshold = 1;
              ActuateDetents = true;
              ForceSuppressed = false;
            };

            magicmouse.MouseButtonMode = "OneButton";

            menuExtraClock = {
              ShowAMPM = true;
              ShowDate = 0; # when space allows
              ShowDayOfWeek = true;
            };

            WindowManager = {
              AutoHide = false;
              HideDesktop = true; # hide desktop items in Stage Manager
              StandardHideWidgets = false;
              StageManagerHideWidgets = false;
            };

            ActivityMonitor.ShowCategory = 102; # My Processes

            loginwindow = {
              GuestEnabled = false;
              LoginwindowText = "Let's Go!";
            };

            screencapture.location = "~/Pictures/screenshots";
            screensaver.askForPasswordDelay = 10;

            # Settings nix-darwin has no typed option for.
            CustomUserPreferences = {
              NSGlobalDomain = {
                AppleMenuBarVisibleInFullscreen = false;
                AppleMiniaturizeOnDoubleClick = false;
                "com.apple.scrollwheel.scaling" = 1;
                "com.apple.sound.beep.flash" = 0;
              };
              "com.apple.universalaccess" = {
                cursorIsCustomized = true;
                # Catppuccin Mocha Peach (#fab387), as normalized sRGB components.
                # Keep the current pointer size; use a black outline below.
                cursorFill = {
                  red = 0.9803921568627451; # 250 / 255
                  green = 0.7019607843137254; # 179 / 255
                  blue = 0.5294117647058824; # 135 / 255
                  alpha = 1.0;
                };
                cursorOutline = {
                  red = 0.0;
                  green = 0.0;
                  blue = 0.0;
                  alpha = 1.0;
                };
              };
              "com.apple.loginwindow".TALLogoutSavesState = false; # don't reopen windows at login
            };
          };
        };
    in
    {
      darwinConfigurations.${host} = nix-darwin.lib.darwinSystem {
        modules = [ configuration ];
      };
    };
}
