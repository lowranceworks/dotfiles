# Cy environment configuration. Copy to .env and fill in real values.
# .env is gitignored — never commit tokens or phone numbers.

# ── iMessage gateway (required for replies) ──
# Comma-separated handles (phone numbers or emails) Cy may talk with.
# Empty = Cy answers nobody (safe default). Your own number is the point.
CY_ALLOWED_HANDLES=

# Where cron jobs without a creator handle send their results.
# Defaults to the first CY_ALLOWED_HANDLES entry — set this when that entry
# is Cy's own number (self-chat) and results should go to your phone.
# CY_NOTIFY_HANDLE=+15551234567

# ── LLM provider ──
# copilot = GitHub Copilot Enterprise cloud models (default)
# local   = the local-llm llama.cpp server on 127.0.0.1:8080
CY_PROVIDER=copilot

# Copilot: token resolution needs nothing here — Cy reads opencode's
# auth store (github-copilot entry) at call time. Refresh it with:
#   opencode auth login github-copilot
# Overrides:
# CY_COPILOT_TOKEN=...                        # use this token instead
# CY_COPILOT_BASE_URL=https://api.githubcopilot.com
# CY_OPENCODE_AUTH=~/.local/share/opencode/auth.json

# Model slots (copilot defaults shown). chat = conversations + ordinary
# delegation; task = GitHub repo work and brainstorming (via sub-agents).
# Available IDs: ./cy --models  (or: curl api.githubcopilot.com/models)
LLM_CHAT_MODEL=claude-haiku-4.5
LLM_TASK_MODEL=claude-fable-5.1

# Local provider (CY_PROVIDER=local):
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=bonsai2-27b        # used for both slots locally

# ── Paths (defaults are fine) ──
# CY_MESSAGES_DB=~/Library/Messages/chat.db
# CY_DATA_DIR=./data
# CY_VERBOSE=1        # tool-call logging to stderr
CY_SHELL=/opt/homebrew/bin/fish   # bash tool runs commands via login fish — same PATH/tools as you

# ── Integrations for skills / custom CLIs (all optional) ──
# GH_TOKEN=ghp_...            # github.com or headless gh use (GHE keyring covers github.mlbam.net)
GH_HOST=github.com
# ATLASSIAN_USERNAME=you@example.com
# ATLASSIAN_URL=https://your-org.atlassian.net
# ATLASSIAN_API_TOKEN=...
# ATLASSIAN_BOARD=/jira/software/c/projects/INF/boards/00000
